#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define LAYER_MAIN 0
#define LAYER_FN 1
#define LAYER_SYMB 2
#define LAYER_NMPAD 3
#define LAYER_MOUSE 4

/ {
    combos {
        compatible = "zmk,combos";

        ret {
            bindings = <&kp ENTER>;
            key-positions = <31 32>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <32 33>;
        };

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <36 37>;
        };

        bspc {
            bindings = <&kp BSPC>;
            key-positions = <38 37>;
        };

        swap_to_mac {
            bindings = <&to 0>;
            key-positions = <42 43 44 45>;
        };

        swap_to_base {
            bindings = <&to 0>;
            key-positions = <50 51 52 53>;
        };
    };

    behaviors {
        balanced_mod_tap: balanced_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "BALANCED_MOD_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            hold-while-undecided-linger;
            quick-tap-ms = <200>;
        };

        tap_layer: tap_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_LAYER";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&bootloader
&none        &none                      &none                         &none                      &none                           &none             &none                         &none                       &none                &none                            &none                      &none                         &none                              &none
&none        &kp Q                      &kp W                         &kp E                      &kp R                           &kp T             &kp LA(LC(LEFT_SHIFT))        &kp LA(LC(LEFT_SHIFT))      &kp Y                &kp U                            &kp I                      &kp O                         &kp P                              &none
&kp CAPS     &balanced_mod_tap LMETA A  &balanced_mod_tap LEFT_ALT S  &balanced_mod_tap LCTRL D  &balanced_mod_tap LEFT_SHIFT F  &tap_layer 3 G                                                              &tap_layer 1 H       &balanced_mod_tap RIGHT_SHIFT J  &balanced_mod_tap LCTRL K  &balanced_mod_tap LEFT_ALT L  &balanced_mod_tap RMETA SEMICOLON  &none
&none        &tap_layer 6 Z             &kp X                         &kp C                      &kp V                           &kp B             &kp LA(LC(LG(LEFT_SHIFT)))    &kp LA(LC(LG(LEFT_SHIFT)))  &kp N                &kp M                            &kp COMMA                  &kp PERIOD                    &tap_layer 6 SLASH                 &none
&none        &none                      &none                         &none                      &none                                                                                                                            &kp LEFT                         &kp DOWN                   &kp UP_ARROW                  &kp RIGHT                          &none
                                                                                                                                 &rgb_ug RGB_ON    &rgb_ug RGB_OFF               &rgb_ug RGB_EFR             &rgb_ug RGB_EFF
                                                                                                 &tap_layer 2 SPACE              &tap_layer 5 TAB  &kp PAGE_UP                   &kp INS                     &tap_layer 4 RETURN  &tap_layer 2 BACKSPACE
                                                                                                                                                   &kp PAGE_DOWN                 &kp DELETE
            >;
        };

        function {
            bindings = <
&bootloader
&none        &none   &none    &none    &none    &none  &none    &none  &none  &none    &none    &none    &none    &none
&none        &kp F1  &kp F2   &kp F3   &kp F4   &none  &none    &none  &none  &kp F13  &kp F14  &kp F15  &kp F16  &none
&none        &kp F5  &kp F6   &kp F7   &kp F8   &none                  &none  &kp F17  &kp F18  &kp F19  &kp F20  &none
&none        &kp F9  &kp F10  &kp F11  &kp F12  &none  &none    &none  &none  &kp F21  &kp F22  &kp F23  &kp F24  &none
&none        &none   &none    &none    &none                                  &none    &none    &none    &none    &none
                                                &none  &none    &none  &none
                                       &none    &none  &none    &none  &none  &none
                                                       &none    &none
            >;
        };

        symbols {
            bindings = <
&bootloader
&none        &none            &none          &none           &none            &none          &none    &none  &none             &none             &none              &none                 &none                  &none
&none        &kp EXCLAMATION  &kp AT_SIGN    &kp HASH        &kp DOLLAR       &kp PERCENT    &none    &none  &kp CARET         &kp AMPERSAND     &kp ASTERISK       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &none
&none        &kp PIPE         &kp EQUAL      &kp MINUS       &kp PLUS         &kp UNDER                      &kp GRAVE         &kp TILDE         &kp COLON          &kp APOS              &kp DOUBLE_QUOTES      &none
&none        &none            &kp BACKSLASH  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LESS_THAN  &none    &none  &kp GREATER_THAN  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LS(SLASH)         &none                  &none
&none        &none            &none          &none           &none                                                             &none             &none              &none                 &none                  &none
                                                                              &none          &none    &none  &none
                                                             &none            &none          &none    &none  &none             &none
                                                                                             &none    &none
            >;
        };

        numpad {
            bindings = <
&bootloader
&none        &none  &none  &none  &none  &none  &none    &none  &none  &none         &none         &none         &none         &none
&none        &none  &none  &none  &none  &none  &none    &none  &none  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &none         &none
&none        &none  &none  &none  &none  &none                  &none  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_0  &kp BACKSPACE
&none        &none  &none  &none  &none  &none  &none    &none  &none  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &none         &none
&none        &none  &none  &none  &none                                &kp LEFT      &kp RIGHT     &none         &none         &none
                                         &none  &none    &none  &none
                                  &none  &none  &none    &none  &none  &kp SPACE
                                                &none    &none
            >;
        };

        mouse {
            bindings = <
&bootloader
&none        &none  &none           &none           &none            &none        &none    &none  &none     &none           &none           &none         &none            &none
&none        &none  &mkp MB4        &mmv MOVE_UP    &mkp MB5         &kp K_COPY   &none    &none  &none     &none           &none           &none         &none            &none
&none        &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp K_PASTE                  &mkp MB4  &mkp LCLK       &mkp MCLK       &mkp RCLK     &mkp MB5         &none
&none        &none  &none           &none           &none            &none        &none    &none  &none     &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none
&none        &none  &none           &none           &none                                                   &none           &none           &none         &none            &none
                                                                     &none        &none    &none  &none
                                                    &none            &none        &none    &none  &none     &none
                                                                                  &none    &none
            >;
        };

        vim_nav {
            bindings = <
&trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans    &trans        &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans    &trans        &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp LEFT  &kp DOWN  &kp UP_ARROW  &kp RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans    &trans        &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans                                      &trans    &trans        &trans     &trans  &trans
                                        &trans  &trans    &trans  &trans
                                &trans  &trans  &trans    &trans  &trans    &trans
                                                &trans    &trans
            >;
        };

        media {
            bindings = <
&none
&none  &none  &none       &none             &none       &none       &none                &none                 &none  &none  &none  &none  &none  &none
&none  &none  &none       &none             &none       &none       &kp C_VOLUME_UP      &kp C_BRIGHTNESS_INC  &none  &none  &none  &none  &none  &none
&none  &none  &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp K_MUTE                                             &none  &none  &none  &none  &none  &none
&none  &none  &none       &none             &none       &none       &kp C_VOLUME_DOWN    &kp C_BRIGHTNESS_DEC  &none  &none  &none  &none  &none  &none
&none  &none  &none       &none             &none                                                                     &none  &none  &none  &none  &none
                                                        &none       &none                &none                 &none
                                            &none       &none       &none                &none                 &none  &none
                                                                    &none                &none
            >;
        };
    };
};
